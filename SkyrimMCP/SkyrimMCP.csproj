<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>SkyrimMCP.snk</AssemblyOriginatorKeyFile>
    <AssemblyTitle>SkyLink AI</AssemblyTitle>
    <Product>SkyLink AI</Product>
    <Description>MCP server connecting AI assistants to Skyrim SE/AE — 89 tools for real-time game interaction</Description>
    <Version>1.3.0</Version>
    <!-- Run as "dotnet SkyrimMCP.dll"; no SkyrimMCP.exe apphost (SmartScreen and antivirus flag unsigned .exe files). -->
    <UseAppHost>false</UseAppHost>
    <!-- Windows x64 only: keeps the ONNX Runtime native DLL for win-x64 and drops the other platforms'. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.3" />
    <!-- Screenshot previews (Windows GDI+; the server is Windows-only anyway). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Face measurement (FEAT-230): MediaPipe's face models run with ONNX Runtime (CPU). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Models\*.onnx;Models\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ONNX Runtime's package ships .lib import libraries next to its DLLs: not needed at run time. -->
  <Target Name="DropNativeImportLibs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
