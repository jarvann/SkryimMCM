<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>SkyrimMCP.snk</AssemblyOriginatorKeyFile>
    <AssemblyTitle>SkyLink AI</AssemblyTitle>
    <Product>SkyLink AI</Product>
    <Description>MCP server connecting AI assistants to Skyrim SE/AE — 89 tools for real-time game interaction</Description>
    <Version>1.2.1</Version>
    <!-- Run as "dotnet SkyrimMCP.dll"; no SkyrimMCP.exe apphost (SmartScreen and antivirus flag unsigned .exe files). -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.3" />
    <!-- Screenshot previews (Windows GDI+; the server is Windows-only anyway). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
